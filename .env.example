TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram allowed users (format: [1,2,3] or [123456789, 987654321] or 123456789,987654321)
ALLOWED_USER_IDS=[123456789, 987654321]
# Optional: separate Telegram proxy (e.g. for Iran where Telegram is filtered)
# TELEGRAM_PROXY_URL=socks5://user:pass@host:port
# TELEGRAM_API_BASE_URL=https://your-telegram-reverse-proxy.com/bot
# Optional: Divar proxy (e.g. for servers outside Iran)
# DIVAR_PROXY_URL=http://user:pass@host:port
# Optional: Divar session auth token (cookie or token for official contact info API)
# DIVAR_AUTH_TOKEN=your_divar_token_here
